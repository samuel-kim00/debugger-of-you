diff --git a/trading_bot/features/indicators.py b/trading_bot/features/indicators.py
--- a/trading_bot/features/indicators.py
+++ b/trading_bot/features/indicators.py
@@ -40,6 +40,14 @@ def enrich_for_ml(out, c):
     out['rsi'] = compute_rsi(c, 14)
     out['atr'] = compute_atr(high, low, c, 14)
+
+    # new: relative volume + price-to-vwap ratio for intraday signals
+    out['rel_volume'] = out['volume'] / out['volume'].rolling(20).mean()
+    vwap = (out['tp'] * out['volume']).cumsum() / out['volume'].cumsum()
+    out['price_vs_vwap'] = (c - vwap) / vwap
+    out['gap_ratio'] = (out['open'] - out['prev_close']) / out['prev_close']
     return out
